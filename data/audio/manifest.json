{
 "L1-001": {
  "file": "L1-001.ogg",
  "hash": "86cc2bb01330",
  "dur": 1.89,
  "text": "雨が降っています。"
 },
 "L1-002": {
  "file": "L1-002.ogg",
  "hash": "82ed3f2dfc72",
  "dur": 2.08,
  "text": "私は学生です。"
 },
 "L1-003": {
  "file": "L1-003.ogg",
  "hash": "9f4ff6cf5689",
  "dur": 1.91,
  "text": "誰が来ましたか。"
 },
 "L1-004": {
  "file": "L1-004.ogg",
  "hash": "a17edab54647",
  "dur": 2.08,
  "text": "田中さんが来ました。"
 },
 "L1-005": {
  "file": "L1-005.ogg",
  "hash": "8a6f72c935c5",
  "dur": 3.58,
  "text": "あの眼鏡をかけている人が田中さんです。"
 },
 "L1-006": {
  "file": "L1-006.ogg",
  "hash": "35694bf7d0ff",
  "dur": 2.78,
  "text": "これは私が作った料理です。"
 },
 "L1-007": {
  "file": "L1-007.ogg",
  "hash": "01bb0c327eb0",
  "dur": 2.16,
  "text": "象は鼻が長いです。"
 },
 "L1-008": {
  "file": "L1-008.ogg",
  "hash": "1897fde1bda4",
  "dur": 3.1,
  "text": "すみません、トイレはどこですか。"
 },
 "L1-009": {
  "file": "L1-009.ogg",
  "hash": "90e307a946f4",
  "dur": 2.17,
  "text": "私は犬が好きです。"
 },
 "L1-010": {
  "file": "L1-010.ogg",
  "hash": "e4a6ccae32d8",
  "dur": 3.08,
  "text": "私は日本語が少しわかります。"
 },
 "L1-011": {
  "file": "L1-011.ogg",
  "hash": "981a24af95f9",
  "dur": 2.6,
  "text": "新しいパソコンがほしいです。"
 },
 "L1-012": {
  "file": "L1-012.ogg",
  "hash": "99e749fe41fe",
  "dur": 1.81,
  "text": "窓があいています。"
 },
 "L1-013": {
  "file": "L1-013.ogg",
  "hash": "353accd6fa6b",
  "dur": 2.1,
  "text": "窓を開けてください。"
 },
 "L1-014": {
  "file": "L1-014.ogg",
  "hash": "dc8a0d1d87e7",
  "dur": 2.42,
  "text": "部屋の電気がついています。"
 },
 "L1-015": {
  "file": "L1-015.ogg",
  "hash": "e99335657929",
  "dur": 2.31,
  "text": "毎朝コーヒーを飲みます。"
 },
 "L1-016": {
  "file": "L1-016.ogg",
  "hash": "1391e0971122",
  "dur": 3.26,
  "text": "この橋を渡ると、駅があります。"
 },
 "L1-017": {
  "file": "L1-017.ogg",
  "hash": "1796b86c126f",
  "dur": 2.48,
  "text": "次の駅で電車を降ります。"
 },
 "L1-018": {
  "file": "L1-018.ogg",
  "hash": "95beec29865e",
  "dur": 2.5,
  "text": "毎日8時に家を出ます。"
 },
 "L1-019": {
  "file": "L1-019.ogg",
  "hash": "bded3d1724ee",
  "dur": 2.27,
  "text": "毎朝7時に起きます。"
 },
 "L1-020": {
  "file": "L1-020.ogg",
  "hash": "e8e231581290",
  "dur": 3.55,
  "text": "1日に3回、薬を飲みます。"
 },
 "L1-021": {
  "file": "L1-021.ogg",
  "hash": "184fbe1b42e0",
  "dur": 2.27,
  "text": "図書館で勉強します。"
 },
 "L1-022": {
  "file": "L1-022.ogg",
  "hash": "3b8939c85a54",
  "dur": 2.08,
  "text": "東京に住んでいます。"
 },
 "L1-023": {
  "file": "L1-023.ogg",
  "hash": "f6bbe3343993",
  "dur": 2.72,
  "text": "駅の前で友達を待ちます。"
 },
 "L1-024": {
  "file": "L1-024.ogg",
  "hash": "eb66a2be2a54",
  "dur": 2.39,
  "text": "机の上に本があります。"
 },
 "L1-025": {
  "file": "L1-025.ogg",
  "hash": "0cb13a3207ce",
  "dur": 3.9,
  "text": "来週、体育館でコンサートがあります。"
 },
 "L1-026": {
  "file": "L1-026.ogg",
  "hash": "6dce617ad7e7",
  "dur": 2.29,
  "text": "駅前でバスに乗ります。"
 },
 "L1-027": {
  "file": "L1-027.ogg",
  "hash": "81f0a698119c",
  "dur": 3.96,
  "text": "私は昨日、駅で友達に会いました。"
 },
 "L1-028": {
  "file": "L1-028.ogg",
  "hash": "6971a4352705",
  "dur": 4.16,
  "text": "私はわからないところを先生に質問しました。"
 },
 "L1-029": {
  "file": "L1-029.ogg",
  "hash": "b13ed9979529",
  "dur": 3.72,
  "text": "私は夜、母に電話をかけました。"
 },
 "L1-030": {
  "file": "L1-030.ogg",
  "hash": "411bc42d71f8",
  "dur": 3.2,
  "text": "私は弟におもちゃを貸しました。"
 },
 "L1-031": {
  "file": "L1-031.ogg",
  "hash": "9577984396a1",
  "dur": 4.13,
  "text": "私は先週、友達に本を借りました。"
 },
 "L1-032": {
  "file": "L1-032.ogg",
  "hash": "e4f5375abed7",
  "dur": 2.19,
  "text": "兄は医者になりました。"
 },
 "L1-033": {
  "file": "L1-033.ogg",
  "hash": "7ea4977be5c3",
  "dur": 2.61,
  "text": "毎日バスで会社へ行きます。"
 },
 "L1-034": {
  "file": "L1-034.ogg",
  "hash": "d197cf3dec2b",
  "dur": 3.95,
  "text": "黒いボールペンでこの紙に名前を書いてください。"
 },
 "L1-035": {
  "file": "L1-035.ogg",
  "hash": "4e3c96efbfe5",
  "dur": 2.58,
  "text": "日本語で手紙を書きました。"
 },
 "L1-036": {
  "file": "L1-036.ogg",
  "hash": "4486043b3be7",
  "dur": 2.58,
  "text": "風邪で学校を休みました。"
 },
 "L1-037": {
  "file": "L1-037.ogg",
  "hash": "e967cf3739ee",
  "dur": 2.81,
  "text": "この仕事は一人でできますか。"
 },
 "L1-038": {
  "file": "L1-038.ogg",
  "hash": "9a389b982212",
  "dur": 2.44,
  "text": "図書館で本を借りました。"
 },
 "L1-039": {
  "file": "L1-039.ogg",
  "hash": "044119d593b2",
  "dur": 4.12,
  "text": "すみません、ここで写真を撮ってもいいですか。"
 },
 "L1-040": {
  "file": "L1-040.ogg",
  "hash": "9a55da6cfdcb",
  "dur": 3.9,
  "text": "私は昨日、友達と映画を見ました。"
 },
 "L1-041": {
  "file": "L1-041.ogg",
  "hash": "c82361b995f0",
  "dur": 3.1,
  "text": "スーパーでりんごとみかんを買いました。"
 },
 "L1-042": {
  "file": "L1-042.ogg",
  "hash": "46219c78d6dd",
  "dur": 3.58,
  "text": "かばんの中に本やノートなどが入っています。"
 },
 "L1-043": {
  "file": "L1-043.ogg",
  "hash": "347c6262154c",
  "dur": 2.75,
  "text": "来週、京都へ行きます。"
 },
 "L1-044": {
  "file": "L1-044.ogg",
  "hash": "58714b07dca1",
  "dur": 2.62,
  "text": "9時から5時まで働きます。"
 },
 "L1-045": {
  "file": "L1-045.ogg",
  "hash": "4e0812e6f1e5",
  "dur": 3.98,
  "text": "夏休みは来週の月曜日から始まります。"
 },
 "L1-046": {
  "file": "L1-046.ogg",
  "hash": "0245d58ee169",
  "dur": 3.96,
  "text": "そうなんだ。じゃあ、私も行こうかな。"
 },
 "L1-047": {
  "file": "L1-047.ogg",
  "hash": "b016112e92a5",
  "dur": 2.22,
  "text": "これは私の本です。"
 },
 "L1-048": {
  "file": "L1-048.ogg",
  "hash": "ad7963791670",
  "dur": 2.91,
  "text": "山田さんは日本語の先生です。"
 },
 "L1-049": {
  "file": "L1-049.ogg",
  "hash": "10c856b514e6",
  "dur": 3.06,
  "text": "あ、それ、私のです。"
 },
 "L1-050": {
  "file": "L1-050.ogg",
  "hash": "d9e0d1251c9e",
  "dur": 2.75,
  "text": "東京は大阪より大きいです。"
 },
 "L1-051": {
  "file": "L1-051.ogg",
  "hash": "0a60a9358358",
  "dur": 2.67,
  "text": "今日は昨日ほど寒くないです。"
 },
 "L1-052": {
  "file": "L1-052.ogg",
  "hash": "c5cb09a3c6f6",
  "dur": 3.23,
  "text": "この服は私にはちょっと大きいです。"
 },
 "L2-001": {
  "file": "L2-001.ogg",
  "hash": "4e6285b66310",
  "dur": 3.21,
  "text": "すみません、窓を開けてください。"
 },
 "L2-002": {
  "file": "L2-002.ogg",
  "hash": "35e9b2238824",
  "dur": 2.11,
  "text": "ちょっと待ってください。"
 },
 "L2-003": {
  "file": "L2-003.ogg",
  "hash": "a45154429173",
  "dur": 3.52,
  "text": "読んだら、その本を返してください。"
 },
 "L2-004": {
  "file": "L2-004.ogg",
  "hash": "8a34b423b1f8",
  "dur": 3.75,
  "text": "朝ご飯を食べてから、学校へ行きます。"
 },
 "L2-005": {
  "file": "L2-005.ogg",
  "hash": "c44cadc3b09e",
  "dur": 2.5,
  "text": "昨日はどこへ行きましたか。"
 },
 "L2-006": {
  "file": "L2-006.ogg",
  "hash": "e65e779f0d81",
  "dur": 2.75,
  "text": "いいえ、まだ食べていません。"
 },
 "L2-007": {
  "file": "L2-007.ogg",
  "hash": "61a06087ae55",
  "dur": 2.83,
  "text": "音楽を聞きながら勉強します。"
 },
 "L2-008": {
  "file": "L2-008.ogg",
  "hash": "750fdc793fcf",
  "dur": 4.31,
  "text": "日曜日は掃除をしたり、洗濯をしたりします。"
 },
 "L2-009": {
  "file": "L2-009.ogg",
  "hash": "40d3b6a32718",
  "dur": 2.77,
  "text": "寝る前に、歯を磨きます。"
 },
 "L2-010": {
  "file": "L2-010.ogg",
  "hash": "bf42996b15c1",
  "dur": 3.38,
  "text": "宿題をした後で、テレビを見ます。"
 },
 "L2-011": {
  "file": "L2-011.ogg",
  "hash": "4304e61175a5",
  "dur": 3.14,
  "text": "私は日本語の新聞が読めます。"
 },
 "L2-012": {
  "file": "L2-012.ogg",
  "hash": "f330b87b9040",
  "dur": 2.64,
  "text": "私は100メートル泳げます。"
 },
 "L2-013": {
  "file": "L2-013.ogg",
  "hash": "27f459a48ce5",
  "dur": 2.86,
  "text": "この魚は生でも食べられます。"
 },
 "L2-014": {
  "file": "L2-014.ogg",
  "hash": "a0a04df3ff61",
  "dur": 2.58,
  "text": "明日は何時に来られますか。"
 },
 "L2-015": {
  "file": "L2-015.ogg",
  "hash": "5b6271cf93d8",
  "dur": 4.22,
  "text": "明日、雨が降ったら、試合は中止です。"
 },
 "L2-016": {
  "file": "L2-016.ogg",
  "hash": "102c323b1421",
  "dur": 2.98,
  "text": "もう少し安ければ、買います。"
 },
 "L2-017": {
  "file": "L2-017.ogg",
  "hash": "05863a4aff8a",
  "dur": 3.02,
  "text": "時間があれば、手伝いますよ。"
 },
 "L2-018": {
  "file": "L2-018.ogg",
  "hash": "91c49f01599b",
  "dur": 3.22,
  "text": "このボタンを押すと、お釣りが出ます。"
 },
 "L2-019": {
  "file": "L2-019.ogg",
  "hash": "e97713fb15d6",
  "dur": 3.2,
  "text": "春になると、桜が咲きます。"
 },
 "L2-020": {
  "file": "L2-020.ogg",
  "hash": "4a372208d191",
  "dur": 4.01,
  "text": "京都へ行くなら、金閣寺がおすすめですよ。"
 },
 "L2-021": {
  "file": "L2-021.ogg",
  "hash": "b3000a2bb280",
  "dur": 3.71,
  "text": "仕事が終わったら、飲みに行きませんか。"
 },
 "L2-022": {
  "file": "L2-022.ogg",
  "hash": "93eadc01efb1",
  "dur": 3.21,
  "text": "うん、雨が降っても、行くよ。"
 },
 "L2-023": {
  "file": "L2-023.ogg",
  "hash": "b8272e4499d6",
  "dur": 2.79,
  "text": "明日は早く起きようと思います。"
 },
 "L2-024": {
  "file": "L2-024.ogg",
  "hash": "c6b4301e7062",
  "dur": 2.23,
  "text": "ええ、行きましょう。"
 },
 "L2-025": {
  "file": "L2-025.ogg",
  "hash": "32818eb75aca",
  "dur": 2.85,
  "text": "週末は家で休むつもりです。"
 },
 "L2-026": {
  "file": "L2-026.ogg",
  "hash": "80ac2ad3e772",
  "dur": 4.13,
  "text": "毎日、日本語を勉強することにしました。"
 },
 "L2-027": {
  "file": "L2-027.ogg",
  "hash": "cf2a7214a7af",
  "dur": 3.75,
  "text": "毎日、薬を飲まなければなりません。"
 },
 "L2-028": {
  "file": "L2-028.ogg",
  "hash": "d291832de177",
  "dur": 2.82,
  "text": "ここで写真を撮らないでください。"
 },
 "L2-029": {
  "file": "L2-029.ogg",
  "hash": "49ded309fd86",
  "dur": 2.54,
  "text": "明日は来なくてもいいですよ。"
 },
 "L2-030": {
  "file": "L2-030.ogg",
  "hash": "d2ce3099e5f5",
  "dur": 3.1,
  "text": "この部屋は広くて、明るいです。"
 },
 "L2-031": {
  "file": "L2-031.ogg",
  "hash": "e351616ca6a5",
  "dur": 3.12,
  "text": "この町は静かで、きれいです。"
 },
 "L2-032": {
  "file": "L2-032.ogg",
  "hash": "7cc1a2aecaf4",
  "dur": 2.62,
  "text": "昨日はとても寒かったです。"
 },
 "L2-033": {
  "file": "L2-033.ogg",
  "hash": "c1e40678f664",
  "dur": 2.68,
  "text": "昨日は一日中暇でした。"
 },
 "L2-034": {
  "file": "L2-034.ogg",
  "hash": "7c16eed21de8",
  "dur": 3.58,
  "text": "先週の旅行はあまり楽しくなかったです。"
 },
 "L2-035": {
  "file": "L2-035.ogg",
  "hash": "c35e54cd3235",
  "dur": 2.52,
  "text": "昨日は天気がよかったです。"
 },
 "L2-036": {
  "file": "L2-036.ogg",
  "hash": "06082b191849",
  "dur": 3.21,
  "text": "見て、外は雨が降っているよ。"
 },
 "L2-037": {
  "file": "L2-037.ogg",
  "hash": "1b781a555857",
  "dur": 2.73,
  "text": "会議室の窓が開けてあります。"
 },
 "L2-038": {
  "file": "L2-038.ogg",
  "hash": "e476d678ba59",
  "dur": 4.03,
  "text": "帰り道で雨に降られて、服がぬれました。"
 },
 "L2-039": {
  "file": "L2-039.ogg",
  "hash": "d56be28486ab",
  "dur": 3.58,
  "text": "先生に褒められて、うれしかったです。"
 },
 "L2-040": {
  "file": "L2-040.ogg",
  "hash": "e887b147c49d",
  "dur": 3.29,
  "text": "母は私に部屋を掃除させました。"
 },
 "L2-041": {
  "file": "L2-041.ogg",
  "hash": "04336daf3c41",
  "dur": 3.48,
  "text": "大事な宿題を家に忘れてしまいました。"
 },
 "L2-042": {
  "file": "L2-042.ogg",
  "hash": "0749d2947a61",
  "dur": 4.22,
  "text": "旅行の前に、自分でホテルを予約しておきます。"
 },
 "L2-043": {
  "file": "L2-043.ogg",
  "hash": "60c2e3e11735",
  "dur": 4.88,
  "text": "すみません、この服、ちょっと着てみてもいいですか。"
 },
 "L2-044": {
  "file": "L2-044.ogg",
  "hash": "246657d2d76e",
  "dur": 3.54,
  "text": "電気をつけたまま、寝てしまいました。"
 },
 "L2-045": {
  "file": "L2-045.ogg",
  "hash": "20d323feb2af",
  "dur": 3.29,
  "text": "この本は字が大きくて読みやすいです。"
 },
 "L2-046": {
  "file": "L2-046.ogg",
  "hash": "4d29f960839c",
  "dur": 2.24,
  "text": "いつか日本へ行きたいです。"
 },
 "L2-047": {
  "file": "L2-047.ogg",
  "hash": "0d5aa8f90877",
  "dur": 3.46,
  "text": "子供は新しいゲームを欲しがっています。"
 },
 "L2-048": {
  "file": "L2-048.ogg",
  "hash": "53b164f12468",
  "dur": 3.02,
  "text": "私はピアノを弾くことができます。"
 },
 "L2-049": {
  "file": "L2-049.ogg",
  "hash": "10f3c549fd41",
  "dur": 4.38,
  "text": "空が暗くなってきた。今にも雨がふりそうです。"
 },
 "L2-050": {
  "file": "L2-050.ogg",
  "hash": "991d921346ad",
  "dur": 4.08,
  "text": "天気予報によると、明日は雨が降るそうです。"
 },
 "L3-001": {
  "file": "L3-001.ogg",
  "hash": "08e39b13ed39",
  "dur": 3.69,
  "text": "雨が降ってきたので、傘をさしました。"
 },
 "L3-002": {
  "file": "L3-002.ogg",
  "hash": "359325320f7a",
  "dur": 3.6,
  "text": "寒いので、帽子をかぶって出かけた。"
 },
 "L3-003": {
  "file": "L3-003.ogg",
  "hash": "a85a31a8363a",
  "dur": 3.52,
  "text": "玄関で靴を履いて、外に出た。"
 },
 "L3-004": {
  "file": "L3-004.ogg",
  "hash": "d562fe5acf31",
  "dur": 2.77,
  "text": "あの眼鏡をかけている人だよ。"
 },
 "L3-005": {
  "file": "L3-005.ogg",
  "hash": "aa09336f9ecf",
  "dur": 4.8,
  "text": "この薬は一日三回、食後に飲んでください。"
 },
 "L3-006": {
  "file": "L3-006.ogg",
  "hash": "dc94c9c3c66f",
  "dur": 3.25,
  "text": "はい、風邪をひいて休むそうです。"
 },
 "L3-007": {
  "file": "L3-007.ogg",
  "hash": "7ee0e3464844",
  "dur": 2.25,
  "text": "なんか熱が出たみたい。"
 },
 "L3-008": {
  "file": "L3-008.ogg",
  "hash": "0205e8e9eada",
  "dur": 3.32,
  "text": "家に帰って、すぐシャワーを浴びた。"
 },
 "L3-009": {
  "file": "L3-009.ogg",
  "hash": "f3c743360d22",
  "dur": 3.62,
  "text": "旅行で富士山の写真をたくさん撮りました。"
 },
 "L3-010": {
  "file": "L3-010.ogg",
  "hash": "d4685c0711c4",
  "dur": 4.25,
  "text": "分からない言葉があったら、辞書を引いてみましょう。"
 },
 "L3-011": {
  "file": "L3-011.ogg",
  "hash": "34da8d64e3c1",
  "dur": 2.52,
  "text": "趣味はピアノを弾くことです。"
 },
 "L3-012": {
  "file": "L3-012.ogg",
  "hash": "8648a4dfd7ee",
  "dur": 3.65,
  "text": "駅に着いたら、家に電話をかけてね。"
 },
 "L3-013": {
  "file": "L3-013.ogg",
  "hash": "e16d00626097",
  "dur": 2.79,
  "text": "電車で1時間ぐらいかかるよ。"
 },
 "L3-014": {
  "file": "L3-014.ogg",
  "hash": "7f1d279a480b",
  "dur": 3.06,
  "text": "昨夜、こわい夢を見たんだ。"
 },
 "L3-015": {
  "file": "L3-015.ogg",
  "hash": "c5dc8b7ed1cd",
  "dur": 3.27,
  "text": "寝る前に、必ず歯を磨きます。"
 },
 "L3-016": {
  "file": "L3-016.ogg",
  "hash": "209837a732b0",
  "dur": 4.93,
  "text": "来週、新しい企画について会議を開く予定です。"
 },
 "L3-017": {
  "file": "L3-017.ogg",
  "hash": "14fb86d23b6c",
  "dur": 4.66,
  "text": "出張中も、お客様と連絡を取るようにしている。"
 },
 "L3-018": {
  "file": "L3-018.ogg",
  "hash": "d267991c46f6",
  "dur": 4.23,
  "text": "部長はミスの責任を取って、会社を辞めた。"
 },
 "L3-019": {
  "file": "L3-019.ogg",
  "hash": "5dd9ff3a54ba",
  "dur": 4.78,
  "text": "このたびはご迷惑をおかけして、申し訳ございません。"
 },
 "L3-020": {
  "file": "L3-020.ogg",
  "hash": "4949ec300cb6",
  "dur": 3.06,
  "text": "うん、三日間休みを取ったんだ。"
 },
 "L3-021": {
  "file": "L3-021.ogg",
  "hash": "559ed3716e75",
  "dur": 3.3,
  "text": "こちらの書類に印鑑を押してください。"
 },
 "L3-022": {
  "file": "L3-022.ogg",
  "hash": "4ef6a9ebb1b6",
  "dur": 4.33,
  "text": "まず計画を立ててから、作業を始めましょう。"
 },
 "L3-023": {
  "file": "L3-023.ogg",
  "hash": "c193e870f069",
  "dur": 4.32,
  "text": "すみません、会議中で電話に出られませんでした。"
 },
 "L3-024": {
  "file": "L3-024.ogg",
  "hash": "73a181cae92d",
  "dur": 3.65,
  "text": "道が凍っているから、気をつけてね。"
 },
 "L3-025": {
  "file": "L3-025.ogg",
  "hash": "baa254bec37a",
  "dur": 4.29,
  "text": "家に帰ってから、財布がないことに気がついた。"
 },
 "L3-026": {
  "file": "L3-026.ogg",
  "hash": "5600ed4f01ce",
  "dur": 3.13,
  "text": "ううん、まだ決心がつかないんだ。"
 },
 "L3-027": {
  "file": "L3-027.ogg",
  "hash": "a4a52e6e58ca",
  "dur": 3.58,
  "text": "うん、趣味も同じで、気が合うんだ。"
 },
 "L3-028": {
  "file": "L3-028.ogg",
  "hash": "008badedbf09",
  "dur": 4.96,
  "text": "新人なので、先輩に気を使いすぎて疲れてしまう。"
 },
 "L3-029": {
  "file": "L3-029.ogg",
  "hash": "3dc2bad347be",
  "dur": 3.08,
  "text": "そのくらい、気にしなくていいよ。"
 },
 "L3-030": {
  "file": "L3-030.ogg",
  "hash": "a36c38e0d802",
  "dur": 4.38,
  "text": "この本は難しくて、全然分かりませんでした。"
 },
 "L3-031": {
  "file": "L3-031.ogg",
  "hash": "589abc546c45",
  "dur": 3.92,
  "text": "バスがなかなか来ないので、タクシーで行った。"
 },
 "L3-032": {
  "file": "L3-032.ogg",
  "hash": "5506258d24ba",
  "dur": 4.34,
  "text": "本当ですか。ぜひうちにも遊びに来てください。"
 },
 "L3-033": {
  "file": "L3-033.ogg",
  "hash": "6691d891ec81",
  "dur": 3.73,
  "text": "空が暗いから、たぶん雨が降るでしょう。"
 },
 "L3-034": {
  "file": "L3-034.ogg",
  "hash": "203c29fa1cd4",
  "dur": 3.84,
  "text": "もし宝くじが当たったら、何をしますか。"
 },
 "L3-035": {
  "file": "L3-035.ogg",
  "hash": "e10b4ab120e9",
  "dur": 3.27,
  "text": "彼の日本語はまるでにほんじんのようだ。"
 },
 "L3-036": {
  "file": "L3-036.ogg",
  "hash": "c4c5ce39f895",
  "dur": 3.93,
  "text": "私は毎朝必ずコーヒーを一杯飲みます。"
 },
 "L3-037": {
  "file": "L3-037.ogg",
  "hash": "bf09f586f964",
  "dur": 3.89,
  "text": "昨日は疲れていたので、ぐっすり眠れた。"
 },
 "L3-038": {
  "file": "L3-038.ogg",
  "hash": "17fcaa41037a",
  "dur": 2.63,
  "text": "うん、ぎりぎり間に合ったよ。"
 },
 "L3-039": {
  "file": "L3-039.ogg",
  "hash": "4c7094ffb1fa",
  "dur": 3.9,
  "text": "うん、年末だから毎日ばたばたしてるよ。"
 },
 "L3-040": {
  "file": "L3-040.ogg",
  "hash": "ac50ef97b38d",
  "dur": 4.51,
  "text": "山田さんはいつもにこにこ笑っていて、感じがいい。"
 },
 "L4-001": {
  "file": "L4-001.ogg",
  "hash": "c553e81172f6",
  "dur": 4.48,
  "text": "誕生日に、姉が私にセーターを編んでくれました。"
 },
 "L4-002": {
  "file": "L4-002.ogg",
  "hash": "049f712f835f",
  "dur": 4.26,
  "text": "私は友達に駅まで車で送ってもらいました。"
 },
 "L4-003": {
  "file": "L4-003.ogg",
  "hash": "52f5ba2f8b53",
  "dur": 5.72,
  "text": "弟が宿題で困っていたので、私が弟に教えてあげました。"
 },
 "L4-004": {
  "file": "L4-004.ogg",
  "hash": "079f5f26c4a8",
  "dur": 3.79,
  "text": "私は田中さんに写真を撮ってもらいました。"
 },
 "L4-005": {
  "file": "L4-005.ogg",
  "hash": "78a06af8a76c",
  "dur": 3.52,
  "text": "ありがとう。母が買ってくれたんです。"
 },
 "L4-006": {
  "file": "L4-006.ogg",
  "hash": "423dc79c2c36",
  "dur": 5.45,
  "text": "はい、友達が手伝いに来てくれたので、すぐ終わりました。"
 },
 "L4-007": {
  "file": "L4-007.ogg",
  "hash": "5f2771ac3895",
  "dur": 4.5,
  "text": "本当？じゃあ、あとで私に送ってくれる？"
 },
 "L4-008": {
  "file": "L4-008.ogg",
  "hash": "fdeac0de5d5e",
  "dur": 5.9,
  "text": "私は先生に推薦状を書いていただき、本当に感謝しております。"
 },
 "L4-009": {
  "file": "L4-009.ogg",
  "hash": "6b0c1d5c4af2",
  "dur": 3.67,
  "text": "部長が駅まで車で送ってくださいました。"
 },
 "L4-010": {
  "file": "L4-010.ogg",
  "hash": "b0ed333eb786",
  "dur": 4.62,
  "text": "部長の本が読みたくて、部長に貸していただきました。"
 },
 "L4-011": {
  "file": "L4-011.ogg",
  "hash": "f0edb8b14059",
  "dur": 5.07,
  "text": "あれ、ペンが床に落ちていますね。誰が落としたんでしょう。"
 },
 "L4-012": {
  "file": "L4-012.ogg",
  "hash": "4493e5d0290d",
  "dur": 2.75,
  "text": "もうすぐ会議が始まりますよ。"
 },
 "L4-013": {
  "file": "L4-013.ogg",
  "hash": "f81059ff482a",
  "dur": 3.56,
  "text": "すみません、コップを割ってしまいました。"
 },
 "L4-014": {
  "file": "L4-014.ogg",
  "hash": "09d47dca0f53",
  "dur": 3.98,
  "text": "うん、今朝ちゃんと届いたよ。ありがとう。"
 },
 "L4-015": {
  "file": "L4-015.ogg",
  "hash": "0e0b85380fac",
  "dur": 3.79,
  "text": "会議室のエアコンは、もうつけてあります。"
 },
 "L4-016": {
  "file": "L4-016.ogg",
  "hash": "176d9b5cf373",
  "dur": 2.82,
  "text": "壁にカレンダーがかけてあります。"
 },
 "L4-017": {
  "file": "L4-017.ogg",
  "hash": "635afb0620fd",
  "dur": 4.67,
  "text": "誰もいない部屋の電気がついていますよ。消しましょうか。"
 },
 "L4-018": {
  "file": "L4-018.ogg",
  "hash": "c2270db7b96c",
  "dur": 4.13,
  "text": "このパソコン、何もしていないのに壊れたんです。"
 },
 "L4-019": {
  "file": "L4-019.ogg",
  "hash": "57f7fab81b54",
  "dur": 3.41,
  "text": "うん、昨日みんなで日程を決めたよ。"
 },
 "L4-020": {
  "file": "L4-020.ogg",
  "hash": "3a14cc853aa2",
  "dur": 3.31,
  "text": "ドアが閉まります。ご注意ください。"
 },
 "L4-021": {
  "file": "L4-021.ogg",
  "hash": "264b0ff9223f",
  "dur": 2.29,
  "text": "ちょっと頭が痛いんです。"
 },
 "L4-022": {
  "file": "L4-022.ogg",
  "hash": "7569b23bb1fc",
  "dur": 3.88,
  "text": "すみません、明日はちょっと用事があるんです。"
 },
 "L4-023": {
  "file": "L4-023.ogg",
  "hash": "e97b566aecae",
  "dur": 2.42,
  "text": "どうして昨日来なかったの？"
 },
 "L4-024": {
  "file": "L4-024.ogg",
  "hash": "895bf9b55bfd",
  "dur": 5.69,
  "text": "すみません、駅へ行きたいんですが、道を教えていただけませんか。"
 },
 "L4-025": {
  "file": "L4-025.ogg",
  "hash": "b73cf02c1f5e",
  "dur": 4.5,
  "text": "ええ、実は昨日、自転車を盗まれたんです。"
 },
 "L4-026": {
  "file": "L4-026.ogg",
  "hash": "dfa5bf40dee9",
  "dur": 2.21,
  "text": "ええ、行きますよ。"
 },
 "L4-027": {
  "file": "L4-027.ogg",
  "hash": "480eaa7e71ba",
  "dur": 3.33,
  "text": "わあ、雪がたくさん降っていますね。"
 },
 "L4-028": {
  "file": "L4-028.ogg",
  "hash": "b5c7e9a58d69",
  "dur": 2.1,
  "text": "道に迷ったかな。"
 },
 "L4-029": {
  "file": "L4-029.ogg",
  "hash": "3fd6e8f8df45",
  "dur": 4.31,
  "text": "えっ、さっき自分で机の上に置いたじゃないですか。"
 },
 "L4-030": {
  "file": "L4-030.ogg",
  "hash": "5fdd6bf0ae56",
  "dur": 4.21,
  "text": "ほら、言ったでしょう？傘を持っていこうって。"
 },
 "L4-031": {
  "file": "L4-031.ogg",
  "hash": "7d9f7a1732f3",
  "dur": 2.42,
  "text": "あの人は先生のようです。"
 },
 "L4-032": {
  "file": "L4-032.ogg",
  "hash": "a512e1ea5b6b",
  "dur": 4.31,
  "text": "今日は休みみたいだよ。机にかばんがないから。"
 },
 "L4-033": {
  "file": "L4-033.ogg",
  "hash": "cc120be6b85b",
  "dur": 3.7,
  "text": "どうやら、かぎを家に忘れてきたようだ。"
 },
 "L4-034": {
  "file": "L4-034.ogg",
  "hash": "d760394e2f53",
  "dur": 3.81,
  "text": "こんなにきれいな景色、まるで夢みたい。"
 },
 "L4-035": {
  "file": "L4-035.ogg",
  "hash": "15c5cfdbbdb4",
  "dur": 3.02,
  "text": "あ、財布を家に忘れちゃった！"
 },
 "L4-036": {
  "file": "L4-036.ogg",
  "hash": "f73c8c1ffee9",
  "dur": 2.66,
  "text": "ごめん、全部食べちゃった。"
 },
 "L4-037": {
  "file": "L4-037.ogg",
  "hash": "04cd5fabbff8",
  "dur": 3.09,
  "text": "弟が私のジュースを飲んじゃった。"
 },
 "L4-038": {
  "file": "L4-038.ogg",
  "hash": "15b396d5adb0",
  "dur": 4.43,
  "text": "昔々、ある村におじいさんが住んでいました。"
 },
 "L4-039": {
  "file": "L4-039.ogg",
  "hash": "1a61bd1408e2",
  "dur": 4.12,
  "text": "おじいさんは山へ、おばあさんは川へ行きました。"
 },
 "L4-040": {
  "file": "L4-040.ogg",
  "hash": "ebe14b5019c4",
  "dur": 2.56,
  "text": "それは私が作りました。"
 },
 "L5-001": {
  "file": "L5-001.ogg",
  "hash": "451aec748c12",
  "dur": 2.94,
  "text": "いつも大変お世話になっております。"
 },
 "L5-002": {
  "file": "L5-002.ogg",
  "hash": "9ef1be52aea5",
  "dur": 3.9,
  "text": "ご確認のほど、よろしくお願いいたします。"
 },
 "L5-003": {
  "file": "L5-003.ogg",
  "hash": "0ce1b46c2f9f",
  "dur": 5.65,
  "text": "お忙しいところ恐れ入りますが、ご確認いただけますと幸いです。"
 },
 "L5-004": {
  "file": "L5-004.ogg",
  "hash": "babef979e369",
  "dur": 4.55,
  "text": "見積書を添付いたしましたので、ご査収ください。"
 },
 "L5-005": {
  "file": "L5-005.ogg",
  "hash": "8b0f41ac5c77",
  "dur": 4.92,
  "text": "ご不明な点がございましたら、お気軽にお問い合わせください。"
 },
 "L5-006": {
  "file": "L5-006.ogg",
  "hash": "ad4ff41728ca",
  "dur": 5.0,
  "text": "資料を拝見しました。修正点をまとめてお送りします。"
 },
 "L5-007": {
  "file": "L5-007.ogg",
  "hash": "b007f88fd842",
  "dur": 4.26,
  "text": "明日は予定どおり、14時に貴社へ伺います。"
 },
 "L5-008": {
  "file": "L5-008.ogg",
  "hash": "05a52f8b7fc8",
  "dur": 5.18,
  "text": "詳細は、弊社の担当者より改めてご連絡いたします。"
 },
 "L5-009": {
  "file": "L5-009.ogg",
  "hash": "3a91c44961f7",
  "dur": 5.55,
  "text": "先日は弊社までお越しいただき、誠にありがとうございました。"
 },
 "L5-010": {
  "file": "L5-010.ogg",
  "hash": "d39e83f3c6ef",
  "dur": 4.92,
  "text": "仕様に問題がないか、ご確認いただけますと幸いです。"
 },
 "L5-011": {
  "file": "L5-011.ogg",
  "hash": "418d193979d9",
  "dur": 4.87,
  "text": "課長、新しい案件の件でご相談があるのですが…。"
 },
 "L5-012": {
  "file": "L5-012.ogg",
  "hash": "5a575e36484a",
  "dur": 3.65,
  "text": "部品の納品が一日遅れるとのことです。"
 },
 "L5-013": {
  "file": "L5-013.ogg",
  "hash": "b8385e409595",
  "dur": 4.75,
  "text": "部長、昨日お送りした資料はもうご覧になりましたか。"
 },
 "L5-014": {
  "file": "L5-014.ogg",
  "hash": "d82c4a08ebf3",
  "dur": 5.25,
  "text": "はい、先ほど部長がおっしゃった件、確認が取れました。"
 },
 "L5-015": {
  "file": "L5-015.ogg",
  "hash": "f550d30879a3",
  "dur": 5.46,
  "text": "先方には昨日お送りしました。今日中にお返事があると思います。"
 },
 "L5-016": {
  "file": "L5-016.ogg",
  "hash": "eca59a22e0ef",
  "dur": 4.12,
  "text": "はい、一つ申し上げてもよろしいでしょうか。"
 },
 "L5-017": {
  "file": "L5-017.ogg",
  "hash": "dbf27b9bd9e8",
  "dur": 4.34,
  "text": "では、来週の金曜日は休ませていただきます。"
 },
 "L5-018": {
  "file": "L5-018.ogg",
  "hash": "fea22d8678a1",
  "dur": 4.21,
  "text": "はい、では私から説明させていただきます。"
 },
 "L5-019": {
  "file": "L5-019.ogg",
  "hash": "a48115733c06",
  "dur": 4.39,
  "text": "部長は、この案についてどうお考えになりますか。"
 },
 "L5-020": {
  "file": "L5-020.ogg",
  "hash": "5afb376fe067",
  "dur": 5.29,
  "text": "先方が資料を送ってくださったので、内容を確認しました。"
 },
 "L5-021": {
  "file": "L5-021.ogg",
  "hash": "efb1d379d508",
  "dur": 3.62,
  "text": "お電話代わりました。営業部の李です。"
 },
 "L5-022": {
  "file": "L5-022.ogg",
  "hash": "1f79ed94107c",
  "dur": 5.03,
  "text": "申し訳ございません。田中はただいま席を外しております。"
 },
 "L5-023": {
  "file": "L5-023.ogg",
  "hash": "ae18c059ffc9",
  "dur": 3.04,
  "text": "あいにく鈴木は外出しております。"
 },
 "L5-024": {
  "file": "L5-024.ogg",
  "hash": "f48298f316ec",
  "dur": 5.04,
  "text": "田中が戻りましたら、こちらから折り返しお電話いたします。"
 },
 "L5-025": {
  "file": "L5-025.ogg",
  "hash": "76deb336d953",
  "dur": 4.07,
  "text": "よろしければ、ご伝言を承りましょうか。"
 },
 "L5-026": {
  "file": "L5-026.ogg",
  "hash": "4f3ad354420d",
  "dur": 5.0,
  "text": "恐れ入りますが、お名前をお伺いしてもよろしいでしょうか。"
 },
 "L5-027": {
  "file": "L5-027.ogg",
  "hash": "0042163273c7",
  "dur": 4.15,
  "text": "田中でございますね。少々お待ちください。"
 },
 "L5-028": {
  "file": "L5-028.ogg",
  "hash": "38667579d09a",
  "dur": 4.09,
  "text": "わたくし、山田工業の鈴木と申します。"
 },
 "L5-029": {
  "file": "L5-029.ogg",
  "hash": "92027d7c8ee6",
  "dur": 2.76,
  "text": "田中は4時ごろ戻る予定です。"
 },
 "L5-030": {
  "file": "L5-030.ogg",
  "hash": "33301b7d9f39",
  "dur": 4.37,
  "text": "念のため、お電話番号を教えていただけますか。"
 },
 "L5-031": {
  "file": "L5-031.ogg",
  "hash": "5f555bf12ff1",
  "dur": 4.08,
  "text": "承知いたしました。早速対応いたします。"
 },
 "L5-032": {
  "file": "L5-032.ogg",
  "hash": "f280b9c0a932",
  "dur": 5.21,
  "text": "おてすうですが、見積もりを再度ご提出いただけますでしょうか。"
 },
 "L5-033": {
  "file": "L5-033.ogg",
  "hash": "d5532fafa07b",
  "dur": 4.08,
  "text": "ありがとうございます。では、いただきます。"
 },
 "L5-034": {
  "file": "L5-034.ogg",
  "hash": "a86c70b551bb",
  "dur": 5.02,
  "text": "明日、取引先の佐藤様が弊社にいらっしゃる予定です。"
 },
 "L5-035": {
  "file": "L5-035.ogg",
  "hash": "6f710ca991ba",
  "dur": 3.6,
  "text": "どうぞ、こちらの資料をご覧ください。"
 },
 "L5-036": {
  "file": "L5-036.ogg",
  "hash": "26459078a86f",
  "dur": 4.12,
  "text": "先日の資料、確かに拝受いたしました。"
 },
 "L5-037": {
  "file": "L5-037.ogg",
  "hash": "f53ce5a65f8e",
  "dur": 4.12,
  "text": "弊社の田中も、そのように申しておりました。"
 },
 "L5-038": {
  "file": "L5-038.ogg",
  "hash": "ce46ca039dfe",
  "dur": 3.67,
  "text": "よろしければ、コーヒーを召し上がりますか。"
 },
 "L5-039": {
  "file": "L5-039.ogg",
  "hash": "9c3aebaf4363",
  "dur": 4.11,
  "text": "ご紹介します。こちらが部長の田中です。"
 },
 "L5-040": {
  "file": "L5-040.ogg",
  "hash": "a27b5b608348",
  "dur": 4.9,
  "text": "恐れ入りますが、こちらにお名前をご記入くださいますか。"
 },
 "L5-041": {
  "file": "L5-041.ogg",
  "hash": "1232a5572c56",
  "dur": 1.81,
  "text": "お疲れ様です。"
 },
 "L5-042": {
  "file": "L5-042.ogg",
  "hash": "27dc12975108",
  "dur": 3.26,
  "text": "すみません、お先に失礼します。"
 },
 "L5-043": {
  "file": "L5-043.ogg",
  "hash": "6bcf7c464ed4",
  "dur": 2.54,
  "text": "あ、お疲れ様でした。"
 },
 "L5-044": {
  "file": "L5-044.ogg",
  "hash": "0b59c47514b2",
  "dur": 2.35,
  "text": "はい、行ってらっしゃい。"
 },
 "L5-045": {
  "file": "L5-045.ogg",
  "hash": "b047fa1fde7d",
  "dur": 1.83,
  "text": "うん、いいよ。"
 },
 "L5-046": {
  "file": "L5-046.ogg",
  "hash": "4adaad90dd32",
  "dur": 2.2,
  "text": "実家に帰ってました。"
 },
 "L5-047": {
  "file": "L5-047.ogg",
  "hash": "c749c1ce0872",
  "dur": 3.4,
  "text": "そうですよね。しかも量も多いし。"
 },
 "L5-048": {
  "file": "L5-048.ogg",
  "hash": "3d797e85a2f6",
  "dur": 4.28,
  "text": "先輩、これ、ちょっと見てもらえますか。"
 },
 "L5-049": {
  "file": "L5-049.ogg",
  "hash": "24a2bf6a4696",
  "dur": 5.62,
  "text": "部長って、前からこういうの好きじゃないですか。きっと通りますよ。"
 },
 "L5-050": {
  "file": "L5-050.ogg",
  "hash": "6c663dbeda88",
  "dur": 3.95,
  "text": "え、そうなんですか？傘持ってこなきゃ。"
 },
 "L6-001": {
  "file": "L6-001.ogg",
  "hash": "733c121cc509",
  "dur": 1.76,
  "text": "承知しました。"
 },
 "L6-002": {
  "file": "L6-002.ogg",
  "hash": "bba873cef941",
  "dur": 2.48,
  "text": "了解、ありがとう！"
 },
 "L6-003": {
  "file": "L6-003.ogg",
  "hash": "122df9e855e9",
  "dur": 3.42,
  "text": "かしこまりました。お待ちしております。"
 },
 "L6-004": {
  "file": "L6-004.ogg",
  "hash": "371a3438b4b7",
  "dur": 2.72,
  "text": "わかった、じゃあまた明日。"
 },
 "L6-005": {
  "file": "L6-005.ogg",
  "hash": "bcbc49530318",
  "dur": 3.06,
  "text": "出張、お疲れ様でした。"
 },
 "L6-006": {
  "file": "L6-006.ogg",
  "hash": "71c48725371d",
  "dur": 4.49,
  "text": "御社のご要望を伺ったうえで、ご提案いたします。"
 },
 "L6-007": {
  "file": "L6-007.ogg",
  "hash": "272ec64ac792",
  "dur": 4.67,
  "text": "弊社としましては、来月の納品を希望しております。"
 },
 "L6-008": {
  "file": "L6-008.ogg",
  "hash": "ee32c910fc61",
  "dur": 3.27,
  "text": "そうなんですね。勉強になります。"
 },
 "L6-009": {
  "file": "L6-009.ogg",
  "hash": "c7a3649e42de",
  "dur": 3.39,
  "text": "え、ほんとに？大丈夫だった？"
 },
 "L6-010": {
  "file": "L6-010.ogg",
  "hash": "c1fb92a8c0bc",
  "dur": 3.42,
  "text": "そうなんですか！寂しくなりますね。"
 },
 "L6-011": {
  "file": "L6-011.ogg",
  "hash": "0c652bb4c952",
  "dur": 5.23,
  "text": "おっしゃる通りです。では、3週間ほどでいかがでしょうか。"
 },
 "L6-012": {
  "file": "L6-012.ogg",
  "hash": "2e05144dba44",
  "dur": 2.73,
  "text": "こちらこそお世話になっております。"
 },
 "L6-013": {
  "file": "L6-013.ogg",
  "hash": "d769ffcd2366",
  "dur": 2.42,
  "text": "いいね、行こう行こう！"
 },
 "L6-014": {
  "file": "L6-014.ogg",
  "hash": "54215c091ed7",
  "dur": 2.6,
  "text": "ごめん、今夜はちょっと…。"
 },
 "L6-015": {
  "file": "L6-015.ogg",
  "hash": "78a9dbb8e4a2",
  "dur": 4.62,
  "text": "そうですね…。一度社内で検討させていただきます。"
 },
 "L6-016": {
  "file": "L6-016.ogg",
  "hash": "71cdc2314f39",
  "dur": 5.36,
  "text": "今週は別件が立て込んでいて、ちょっと難しいかもしれません…。"
 },
 "L6-017": {
  "file": "L6-017.ogg",
  "hash": "e038cc4b991e",
  "dur": 4.9,
  "text": "大変恐縮ですが、今回のご依頼はお受けいたしかねます。"
 },
 "L6-018": {
  "file": "L6-018.ogg",
  "hash": "7c1b9c78a1b2",
  "dur": 2.97,
  "text": "うーん、ホラーはちょっと苦手で…。"
 },
 "L6-019": {
  "file": "L6-019.ogg",
  "hash": "3ea3b2863f33",
  "dur": 5.93,
  "text": "いいと思います。ただ、納期の面で少し気になる点があるのですが。"
 },
 "L6-020": {
  "file": "L6-020.ogg",
  "hash": "c5daa61cafbd",
  "dur": 4.72,
  "text": "大変申し訳ございません。すぐに確認いたします。"
 },
 "L6-021": {
  "file": "L6-021.ogg",
  "hash": "4dd5a43d56ae",
  "dur": 2.12,
  "text": "あ、すみません。"
 },
 "L6-022": {
  "file": "L6-022.ogg",
  "hash": "6ca2e94f3252",
  "dur": 3.48,
  "text": "ありがとうございます。助かりました。"
 },
 "L6-023": {
  "file": "L6-023.ogg",
  "hash": "9880d7b768dc",
  "dur": 2.12,
  "text": "ごちそうさまでした。"
 },
 "L6-024": {
  "file": "L6-024.ogg",
  "hash": "c667f8b3a2f7",
  "dur": 5.29,
  "text": "本日はお忙しいところ、お越しいただきありがとうございます。"
 },
 "L6-025": {
  "file": "L6-025.ogg",
  "hash": "b9b085bcc896",
  "dur": 3.06,
  "text": "ごめんごめん、電車が遅れてて。"
 },
 "L6-026": {
  "file": "L6-026.ogg",
  "hash": "007ee453c519",
  "dur": 2.54,
  "text": "部長は明日いらっしゃいますか。"
 },
 "L6-027": {
  "file": "L6-027.ogg",
  "hash": "f21bcae14008",
  "dur": 2.73,
  "text": "田中さんはどうお考えですか。"
 },
 "L6-028": {
  "file": "L6-028.ogg",
  "hash": "0f77c8f67c6a",
  "dur": 1.66,
  "text": "めっちゃおいしい！"
 },
 "L6-029": {
  "file": "L6-029.ogg",
  "hash": "4c3d63d261f3",
  "dur": 1.73,
  "text": "3時からです。"
 },
 "L6-030": {
  "file": "L6-030.ogg",
  "hash": "f8138826f1bb",
  "dur": 4.23,
  "text": "おてすうをおかけしました。ありがとうございました。"
 },
 "L6-031": {
  "file": "L6-031.ogg",
  "hash": "f49f782f68cf",
  "dur": 3.85,
  "text": "明日、休みを取ってもよろしいでしょうか。"
 },
 "L6-032": {
  "file": "L6-032.ogg",
  "hash": "472de170ba2e",
  "dur": 2.56,
  "text": "はい、承知しました。"
 },
 "L6-033": {
  "file": "L6-033.ogg",
  "hash": "bd0a33dd1865",
  "dur": 4.25,
  "text": "申し訳ございません、私ではわかりかねます。"
 },
 "L6-034": {
  "file": "L6-034.ogg",
  "hash": "2e02d95a6e29",
  "dur": 3.57,
  "text": "うーん、よく考えてから返事するね。"
 },
 "L6-035": {
  "file": "L6-035.ogg",
  "hash": "479fb23ec295",
  "dur": 3.6,
  "text": "眼鏡をかけないと、文字がよく見えない。"
 },
 "L6-036": {
  "file": "L6-036.ogg",
  "hash": "a6e8c6494d8b",
  "dur": 4.19,
  "text": "うん、知ってるよ。同じ大学だったから。"
 },
 "L6-037": {
  "file": "L6-037.ogg",
  "hash": "8cbaa34485ae",
  "dur": 5.42,
  "text": "お誘いありがとうございます。あいにくその日は先約がありまして…。"
 },
 "L6-038": {
  "file": "L6-038.ogg",
  "hash": "5073fa150cee",
  "dur": 4.29,
  "text": "課長、ちょっとご相談したいことがあるんですが…。"
 },
 "L6-039": {
  "file": "L6-039.ogg",
  "hash": "ed71af4a50cd",
  "dur": 5.21,
  "text": "申し訳ありません、データの確認に時間がかかっておりまして…。"
 },
 "L6-040": {
  "file": "L6-040.ogg",
  "hash": "b1989339a081",
  "dur": 3.38,
  "text": "あー、今ちょっと使ってるんだけど…。"
 }
}